####
# Self-contained multi-stage build: builds the Quarkus app from source (no
# dependency on a pre-built local target/ directory, which is gitignored
# and so isn't available to platforms like Railway that build from an
# uploaded/cloned source tree), then runs it on a slim JRE image.
#
# Build with:
#
# docker build -f src/main/docker/Dockerfile.jvm -t codecheck-quarkus:1.0-SNAPSHOT .
#
# Then run the container using:
#
# docker run -i --rm -p 8080:8080 codecheck-quarkus:1.0-SNAPSHOT
###

FROM eclipse-temurin:25-jdk-noble AS build

RUN apt-get update \
  && apt-get install -y --no-install-recommends curl \
  && curl -fsSL https://dlcdn.apache.org/maven/maven-3/3.9.16/binaries/apache-maven-3.9.16-bin.tar.gz | tar -xz -C /opt \
  && ln -s /opt/apache-maven-3.9.16/bin/mvn /usr/local/bin/mvn \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY pom.xml .
COPY src ./src
RUN mvn -B package -Dmaven.test.skip

FROM eclipse-temurin:25-jre-noble

ENV LANGUAGE='en_US:en'

WORKDIR /deployments/
RUN addgroup --system javauser && adduser --system --shell /usr/sbin/nologin --ingroup javauser javauser

# We make four distinct layers so if there are application changes the library layers can be re-used
COPY --chown=javauser:javauser --from=build /build/target/quarkus-app/lib/ /deployments/lib/
COPY --chown=javauser:javauser --from=build /build/target/quarkus-app/*.jar /deployments/
COPY --chown=javauser:javauser --from=build /build/target/quarkus-app/app/ /deployments/app/
COPY --chown=javauser:javauser --from=build /build/target/quarkus-app/quarkus/ /deployments/quarkus/

EXPOSE 8080
USER javauser
ENTRYPOINT ["java", "-jar", "quarkus-run.jar"]
